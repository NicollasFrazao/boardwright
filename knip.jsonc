{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": [
        "eslint-rules/**/*.mjs",
        "scripts/**/*.mjs"
      ]
    },
    "packages/testing": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  }
}
