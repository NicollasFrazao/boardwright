{
  "name": "boardwright-monorepo",
  "version": "0.0.0",
  "description": "Agentic delivery pipelines driven by GitHub Projects: board columns map to agent roles, run locally or in GitHub Actions.",
  "license": "MIT",
  "author": "Nícollas Frazão",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:tooling": "vitest run --project tooling",
    "test:coverage": "vitest run --coverage",
    "check:architecture": "depcruise scripts eslint-rules --config .dependency-cruiser.cjs",
    "check:unused": "knip",
    "check:context": "node scripts/check-context-surfaces.mjs",
    "export:context": "node scripts/check-context-surfaces.mjs --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "knip": "6.44.1",
    "lint-staged": "17.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
